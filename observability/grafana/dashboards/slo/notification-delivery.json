{
  "uid": "slo-notification-delivery",
  "title": "Notification delivery",
  "description": ">= 99% of push notifications sent within 5 min of their trigger (outside quiet hours). SLI and budget over a rolling 28d. Generated by packages/telemetry/src/dashboards (make dashboards); do not edit in Grafana.",
  "tags": ["riviera", "slo"],
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-28d",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "utc",
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Notifications sent within 5 min",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Target",
      "description": "Notifications sent within 5 min: 99% over 28d.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "vector(0.99)",
          "legendFormat": "target",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data recorded yet",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "SLI (28d)",
      "description": "Measured share over the last 28d.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(clamp(sum(increase(riviera_notification_delivery_delay_seconds_bucket{le=~\"300|300.0\"}[28d])) / sum(increase(riviera_notification_delivery_delay_seconds_count[28d])), 0, 1)) and on() (sum(increase(riviera_notification_delivery_delay_seconds_count[28d])) > 0)",
          "legendFormat": "SLI",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data recorded yet",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error budget remaining (28d)",
      "description": "1 − (1 − SLI) / (1 − target); below 0 means the budget is spent.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(1 - (1 - clamp(sum(increase(riviera_notification_delivery_delay_seconds_bucket{le=~\"300|300.0\"}[28d])) / sum(increase(riviera_notification_delivery_delay_seconds_count[28d])), 0, 1)) / (1 - 0.99)) and on() (sum(increase(riviera_notification_delivery_delay_seconds_count[28d])) > 0)",
          "legendFormat": "budget",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data recorded yet",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "SLI over time (rolling 28d)",
      "description": "Each point is the SLI of the 28 days before it.",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(clamp(sum(increase(riviera_notification_delivery_delay_seconds_bucket{le=~\"300|300.0\"}[28d])) / sum(increase(riviera_notification_delivery_delay_seconds_count[28d])), 0, 1)) and on() (sum(increase(riviera_notification_delivery_delay_seconds_count[28d])) > 0)",
          "legendFormat": "SLI",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data recorded yet",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}

# Copy to .env and fill in. Never commit .env.

# Public URL of the tool. Sign-in links, the PWA manifest and push setup will use it.
# Locally this is the proxy; later it becomes the Cloudflare Tunnel hostname.
APP_URL=http://localhost:8080

# Port the proxy binds on 127.0.0.1 (never on a public interface).
PROXY_PORT=8080

# Postgres. Use URL-safe characters in the password (letters, digits, - and _).
POSTGRES_USER=riviera
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=riviera

LOG_LEVEL=info

# Added by later features (listed here so nobody invents other names):
# COMMON_GROUND_ADMIN_API_KEY=      (sync, 004+)
# COMMON_GROUND_WRITES_ENABLED=false (staff checkout; only Antn turns this on)
# DISCOGS_TOKEN_ENCRYPTION_KEY=
# SESSION_SECRET=                    (auth, 002)
# SMTP_URL=                          (auth, 002)
# WEB_PUSH_PUBLIC_KEY= / WEB_PUSH_PRIVATE_KEY=
# CLOUDFLARE_TUNNEL_TOKEN=           (once the domain is chosen)

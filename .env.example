# Copy to .env and fill in. Never commit .env.

# Public URL of the tool. Sign-in links, the PWA manifest and push setup will use it.
# Locally this is the proxy; later it becomes the Cloudflare Tunnel hostname.
APP_URL=http://localhost:8080

# Port the proxy binds on 127.0.0.1 (never on a public interface).
PROXY_PORT=8080

# Postgres. Use URL-safe characters in the password (letters, digits, - and _).
POSTGRES_USER=riviera
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=riviera

LOG_LEVEL=info

# Observability (001). Leave the endpoint empty: telemetry export is then off, so the plain
# stack logs no "telemetry dropped" warnings. `make up-observability` sets it to
# http://otel-collector:4318 for you.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Grafana binds on 127.0.0.1 only. Viewers are anonymous; the admin password is for edits.
GRAFANA_PORT=3300
GRAFANA_ADMIN_PASSWORD=change-me-locally

# Sample flows (development and CI only). Don't set these here: `make up-dev` and the CI stack
# job set them. The api and worker refuse to start with SAMPLE_FLOWS_ENABLED=true unless
# DEPLOYMENT_ENVIRONMENT is explicitly development or ci; unset means production.
# SAMPLE_FLOWS_ENABLED=false          (true | false)
# DEPLOYMENT_ENVIRONMENT=production   (development | ci | production)
# COMMON_GROUND_URL=                  (local mock only, e.g. http://mocks:4000; common-ground.io
#                                      is refused)
# DISCOGS_URL=                        (local mock only; discogs.com is refused)
# COMMON_GROUND_DEV_API_KEY=          (dev-only key for the Common Ground mock's Authorization
#                                      header; any value works, never a real key; redacted)

# Added by later features (listed here so nobody invents other names):
# COMMON_GROUND_ADMIN_API_KEY=      (sync, 004+)
# COMMON_GROUND_WRITES_ENABLED=false (staff checkout; only Antn turns this on)
# DISCOGS_TOKEN_ENCRYPTION_KEY=
# SESSION_SECRET=                    (auth, 002)
# SMTP_URL=                          (auth, 002)
# WEB_PUSH_PUBLIC_KEY= / WEB_PUSH_PRIVATE_KEY=
# CLOUDFLARE_TUNNEL_TOKEN=           (once the domain is chosen)
